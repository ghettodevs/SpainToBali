RewriteEngine On

# 1. Forzar HTTPS (Seguridad)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Eliminar la extensión .php de las URLs
# Esto permite que spaintobali.es/gracias cargue gracias.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 3. Evitar que se listan las carpetas (Seguridad)
Options -Indexes

# 4. Compresión GZIP (Para que la web vuele)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>